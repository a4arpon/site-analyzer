{
  "disable_ai":false,
 "languages": {
   "JavaScript": {
     "language_servers": [
       "deno","codebook"
     ]
   },
   "TypeScript": {
     "language_servers": [
       "deno","codebook"]
   }
 },
  "formatter": {
    "language_server": {
      "name": "deno"
    }
  },
  "code_actions_on_format": {
    "source.fixAll.deno": true,
    "source.organizeImports": true
  }
}
