{
  "$schema": "./schema.json",
  "metadata": {
    "name": "E-commerce Schema Add-on",
    "slug": "e-commerce",
    "description": "Commerce layer: Product, Offer, and BreadcrumbList JSON-LD validity. Load together with core: --rule=./rules/core.json,./rules/e-commerce.json",
    "version": "1.1.0",
    "category": "e-commerce",
    "tags": ["e-commerce", "jsonld", "schema", "product"],
    "createdBy": {
      "name": "Xia",
      "email": "a4arpon@email.com",
      "url": "https://github.com/a4arpon"
    },
    "updatedAt": "2026-10-08",
    "license": "MIT"
  },
  "rules": {
    "JSONLD-02": {
      "id": "JSONLD-02",
      "name": "Product Schema Validity",
      "description": "When a Product schema is present, agents expect name, image, sku, and offers.price with priceCurrency. Missing or mistyped fields break product cards in agent answers and shopping integrations.",
      "category": "e-commerce",
      "priority": "P1",
      "check": {
        "type": "jsonld",
        "jsonldType": "Product",
        "requireContextSchemaOrg": true,
        "requiredFields": ["name", "image", "offers.price", "sku"],
        "fieldTypes": {
          "name": "string",
          "image": "url",
          "offers.price": "number",
          "sku": "string"
        },
        "requiredGroups": [["offers.price", "offers.priceCurrency"]],
        "patterns": { "offers.priceCurrency": "^[A-Z]{3}$" },
        "scope": "page"
      },
      "fix": {
        "instruction": "Ensure the Product JSON-LD includes name (string), sku (string), image (absolute URL), and offers with price (number) + priceCurrency (3-letter ISO code). Set @context to https://schema.org.",
        "codeSnippet": "{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Widget\",\n  \"sku\": \"WGT-001\",\n  \"image\": \"https://example.com/img/widget.jpg\",\n  \"offers\": { \"@type\": \"Offer\", \"price\": 19.99, \"priceCurrency\": \"USD\" }\n}",
        "effort": "moderate",
        "automated": false
      },
      "impact": {
        "seo": "high",
        "agent": "blocking",
        "performance": "none",
        "conversion": "direct-loss"
      }
    },
    "JSONLD-04": {
      "id": "JSONLD-04",
      "name": "Offer Schema Validity",
      "description": "Offer nodes drive price and availability display in agent answers. price must be a positive number, priceCurrency a 3-letter ISO code, and availability a schema.org URL — otherwise shopping agents drop the offer.",
      "category": "e-commerce",
      "priority": "P1",
      "check": {
        "type": "jsonld",
        "jsonldType": "Offer",
        "requireContextSchemaOrg": true,
        "requiredFields": ["price", "priceCurrency"],
        "fieldTypes": { "price": "number", "priceCurrency": "string" },
        "patterns": { "priceCurrency": "^[A-Z]{3}$" },
        "numericRange": { "price": { "min": 0, "exclusiveMin": true } },
        "enumValues": {
          "availability": [
            "https://schema.org/InStock",
            "https://schema.org/OutOfStock",
            "https://schema.org/PreOrder",
            "https://schema.org/Discontinued",
            "InStock",
            "OutOfStock",
            "PreOrder",
            "Discontinued"
          ]
        },
        "scope": "page"
      },
      "fix": {
        "instruction": "Every Offer needs price (number > 0), priceCurrency (uppercase 3-letter ISO, e.g. USD), and optionally availability as a schema.org URL.",
        "codeSnippet": "\"offers\": {\n  \"@type\": \"Offer\",\n  \"price\": 19.99,\n  \"priceCurrency\": \"USD\",\n  \"availability\": \"https://schema.org/InStock\"\n}",
        "effort": "easy",
        "automated": false
      },
      "impact": {
        "seo": "high",
        "agent": "blocking",
        "performance": "none",
        "conversion": "direct-loss"
      }
    },
    "JSONLD-05": {
      "id": "JSONLD-05",
      "name": "BreadcrumbList Schema Present",
      "description": "BreadcrumbList lets agents and search engines reconstruct site hierarchy for the page — they render it as trail context in answers. Stores without it appear as flat, contextless product pages.",
      "category": "e-commerce",
      "priority": "P2",
      "check": {
        "type": "jsonld",
        "jsonldType": "BreadcrumbList",
        "requireContextSchemaOrg": true,
        "requiredFields": ["itemListElement"],
        "scope": "page"
      },
      "fix": {
        "instruction": "Add BreadcrumbList JSON-LD mirroring the visible breadcrumb trail: name + position per item, with absolute item URLs.",
        "codeSnippet": "{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"BreadcrumbList\",\n  \"itemListElement\": [\n    { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://example.com/\" },\n    { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"Widgets\", \"item\": \"https://example.com/widgets\" }\n  ]\n}",
        "effort": "moderate",
        "automated": false
      },
      "impact": {
        "seo": "high",
        "agent": "degraded",
        "performance": "none",
        "conversion": "friction"
      }
    }
  }
}
