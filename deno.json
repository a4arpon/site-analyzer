{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "version": "0.0.1",
  "nodeModulesDir": "auto",
  "jsrDepsInNodeModules": true,
  "preferPackageJson": true,
  "tasks": {
    "dev": "deno run --allow-net --allow-read ./src/app.ts",
    "build:compile": "deno compile --bundle --minify --allow-net --allow-read --allow-env --target x86_64-unknown-linux-gnu --engine quickjs --output ./dist/web-analyzer-qjs ./src/app.ts",
    "build:compile-v8":"deno compile --bundle --minify --allow-net --allow-read --allow-env --target x86_64-unknown-linux-gnu --output ./dist/web-analyzer-v8 ./src/app.ts"
  },
  "imports": {
    "#src/": "./src/"
  },
  "lint": {
    "include": ["./src/*"],
    "rules": { "tags": ["recommended"] }
  },
  "fmt": {
    "lineWidth": 80,
    "include": [
      "./src/*","./src/assets/*"
    ],
    "semiColons": false,
    "useTabs": false
  },
  "unstable": ["tsgo"],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "esnext",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "lib": [
      "deno.ns",
      "esnext"
    ]
  }
}
